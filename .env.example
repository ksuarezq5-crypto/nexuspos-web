# Copia este archivo a ".env" y llena los valores reales.

# URL y clave ANON (publica, NO la Service Role Key) de tu proyecto de Supabase.
# Las encuentras en supabase.com/dashboard/project/_/settings/api-keys
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Enlaces directos de descarga (sube los archivos al bucket publico de Supabase
# Storage que ya usas para las actualizaciones, o a cualquier hosting propio,
# y pega aqui la URL publica resultante).
VITE_DEMO_INSTALLER_URL=
VITE_MOBILE_APK_URL=
